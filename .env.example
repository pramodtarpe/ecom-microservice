# Copy this file to .env. Docker Compose will reject an empty JWT_SECRET.
# Set at least 32 UTF-8 bytes; use a newly generated value, not a committed secret.
JWT_SECRET=
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce-api

# Local proof-of-concept seed accounts only. Change or disable them elsewhere.
AUTH_SEED_ENABLED=true
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_DISPLAY_NAME=POC Administrator
AUTH_ADMIN_PASSWORD=ChangeMeAdmin123!
AUTH_USER_EMAIL=user@example.com
AUTH_USER_DISPLAY_NAME=POC User
AUTH_USER_PASSWORD=ChangeMeUser123!

PRODUCT_SEED_ENABLED=true
INVENTORY_SEED_ENABLED=true
